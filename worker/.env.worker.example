# قالب بيئة العامل — انسخه إلى worker/.env.worker واملأ القيم الحقيقية هناك.
# worker/.env.worker مُتجاهَل في git ولا يُرفع أبداً.

# اتصال Supabase (نفس قيم مشروع العقل الثاني — المفتاح Service Role من لوحة Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# اسم صاحب العقل كما يظهر في البرومبتات (نفس قيمة OWNER_NAME في بيئة Vercel)
OWNER_NAME=
# OWNER_TIMEZONE=Asia/Riyadh   # منطقتك الزمنية IANA (نفس قيمة بيئة Vercel)

# النموذج المنفِّذ على جلسة الاشتراك (اختر النموذج الذي يتيحه اشتراكك)
WORKER_MODEL=claude-fable-5

# إشعار تيليجرام عند اكتمال/فشل المسودة (اختياري — نفس قيم البوت القائمة)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# ── الناقد الخارجي (الملف 17): يتطلب Codex CLI مسجَّل دخول ChatGPT على الخادم ──
# النموذج وعمق التفكير للناقد الخارجي (يحكم ولا يكتب)
CODEX_MODEL=gpt-5.6-sol
CODEX_EFFORT=xhigh
# CODEX_BIN=codex           # مسار أمر codex إن لم يكن في PATH

# ── اختيارية (لها افتراضات سليمة — لا تضبطها إلا لحاجة) ──
# ملاحظة: منتقيا «النموذج/عمق التفكير» في الواجهة يتقدمان على القيمتين هنا لكل طلب.
# WORKER_EFFORT=            # low|medium|high|xhigh — تُمرَّر كـ--effort (العلم مؤكد في CLI 2.1.220)؛ جرّب بـ--once بعد أي ترقية CLI
# WORKER_POLL_MS=5000       # فاصل استطلاع الطابور
# WORKER_TIMEOUT_MS=1800000 # مهلة نداء الجلسة الواحد (٣٠ دقيقة)
# WORKER_LIMIT_BACKOFF_MS=1200000 # الإرجاء بعد بلوغ حد استخدام الاشتراك (٢٠ دقيقة)
# WORKER_MAX_ATTEMPTS=3     # محاولات الطلب قبل إعلانه فاشلاً
# WORKER_STALE_MINUTES=30   # عمر القفل البائت قبل استرداد الطلب اليتيم

# ── الحصاد الأسبوعي لأرقام إكس (الملف 25) ──
# X_PROVIDER_API_KEY=       # مفتاح مزود بيانات إكس
# X_ACCOUNT_HANDLE=         # معرّف حسابك على إكس بدون @ (مطلوب مع الحصاد)

# ── مسودات Typefully (الملف 22) ──
# TYPEFULLY_API_KEY=
# TYPEFULLY_SOCIAL_SET_ID=  # اختياري — يُجلب تلقائياً إن غاب

# ── النشر عبر لوبس (الملفان 34 و35) ──
# LOOPS_API_KEY=
# هوية المرسل: LOOPS_FROM_EMAIL و LOOPS_FROM_NAME مطلوبان للنشر (النشر يفشل برسالة عربية إن غابا)
# LOOPS_FROM_EMAIL=         # الجزء قبل @ فقط، على نطاق مُرسِل مُوثَّق في لوبس
# LOOPS_FROM_NAME=
# LOOPS_REPLY_TO=           # اختياري — بريد الردود
