# انسخ هذا الملف إلى .env.local واملأ القيم. لا ترفع .env.local أبداً.
# Copy to .env.local and fill in. Never commit .env.local.

# ── الهوية — Identity ──
OWNER_NAME=                 # اسمك كما يظهر في البرومبتات ورسائل البوت
OWNER_TIMEZONE=Asia/Riyadh  # منطقة IANA لحساب «اليوم» (اضبط مواعيد vercel.json لتوافقها)

# ── Supabase (إلزامي) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── الذكاء — AI ──
GEMINI_API_KEY=             # إلزامي: التضمين (768 بُعداً) والتصنيف والتحليل والمحادثة
ANTHROPIC_API_KEY=          # اختياري: مسار التوليد «المباشر» الطارئ (بدون العامل)

# ── تيليجرام — قناة الالتقاط الأساسية ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=   # معرّف محادثتك وحدك — البوت يتجاهل غيره
TELEGRAM_WEBHOOK_SECRET=    # سرّ عشوائي طويل

# ── الجدولة — Vercel Cron ──
CRON_SECRET=                # سرّ عشوائي طويل

# ── اختياري: النشرة البريدية عبر Loops ──
LOOPS_API_KEY=
LOOPS_WEBHOOK_SECRET=
LOOPS_FROM_NAME=
LOOPS_FROM_EMAIL=
LOOPS_REPLY_TO=
LOOPS_AUDIENCES=             # مصفوفة JSON من {key,type,id,label} — انظر docs/SETUP.md
WARMTH_INTERVAL_DAYS=7       # فاصل تحديث الدفء البريدي بالأيام

# ── اختياري: الجدولة على إكس عبر Typefully ──
TYPEFULLY_API_KEY=
TYPEFULLY_SOCIAL_SET_ID=
